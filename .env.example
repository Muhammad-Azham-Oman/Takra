# Production settings for the Node.js service. Keep the real .env out of Git.
NODE_ENV=production
PORT=3000
PUBLIC_ORIGIN=
TRUST_PROXY_HOPS=
DATABASE_URL=
APP_SECRET=
RETENTION_DAYS=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Set both IDs after provisioning the organizer's private resources.
GOOGLE_PARENT_FOLDER_ID=
GOOGLE_SPREADSHEET_ID=
GOOGLE_ALLOWED_EMAILS=
GOOGLE_ROW_LIMIT=20000

# Set GOOGLE_AUTH_MODE=oauth for the organizer account, then set its credentials.
GOOGLE_AUTH_MODE=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Optional public contact details displayed by the portal.
ORGANIZER_NAME=
ORGANIZER_EMAIL=
